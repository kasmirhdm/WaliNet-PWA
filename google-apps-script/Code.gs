const SPREADSHEET_ID = "ISI_ID_GOOGLE_SHEET_DI_SINI";
function json(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){const action=(e.parameter.action||"dashboard").toLowerCase(),ss=SpreadsheetApp.openById(SPREADSHEET_ID);if(action==="customers")return json(readSheet(ss.getSheetByName("Pelanggan")));if(action==="payments")return json(readSheet(ss.getSheetByName("Pembayaran")));if(action==="packages")return json(readSheet(ss.getSheetByName("Paket")));if(action==="bill"){const key=(e.parameter.key||"").trim(),rows=readSheet(ss.getSheetByName("Pelanggan")),found=rows.find(r=>String(r.ID)===key||String(r["No HP"])===key);return json(found||{error:"Pelanggan tidak ditemukan"})}return json({ok:true,service:"WaliNet API"})}
function readSheet(sh){if(!sh)return[];const v=sh.getDataRange().getValues();if(v.length<2)return[];const h=v.shift().map(String);return v.map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]])))}